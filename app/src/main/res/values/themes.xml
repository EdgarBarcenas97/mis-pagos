<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppBase" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash de arranque (core-splashscreen, compatible desde minSdk 26).
         Fondo = color primario de AppTheme (light). -->
    <style name="Theme.AppBase.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.AppBase</item>
    </style>
</resources>
